  createdAt DateTime @default(now())

  @@index([userId])
}

/// Sobriety streak counter — "sober from X since Y", with relapse history.
model SobrietyCounter {
  id          String            @id @default(cuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String // alcohol | drugs | nicotine | masturbation | custom...
