}

model MedicalExtractedItem {
  id        String        @id @default(cuid())
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  recordId  String
  itemType  String?
  label     String
  value     String?
  unit      String?
  createdAt DateTime      @default(now())

