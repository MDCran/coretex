generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core: auth, account, settings
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  passwordHash String
  name         String?
  avatarKey    String? // S3 object key
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       UserProfile?
  settings      Settings?
  spotify       SpotifyConnection?
  genius        GeniusConnection?
  alpaca        AlpacaConnection?
  plaidItems    PlaidItem[]
  plaidAccounts PlaidAccount[]

  notifications  Notification[]
  todos          TodoItem[]
  aiCalls        AiCall[]
  insights       Insight[]
  scoreSnapshots ScoreSnapshot[]

  calendarEvents  CalendarEvent[]
  eventCategories EventCategory[]

  companies             Company[]
  jobPhases             JobPhase[]
  jobApplications       JobApplication[]
  jobDocuments          JobDocument[]
  jobContacts           JobContact[]
  jobSearchLocations    JobSearchLocation[]
  jobSearchProfile      JobSearchProfile?
  suggestedCompanies    SuggestedCompany[]
  jobLeads              JobLead[]
  jobSearchRuns         JobSearchRun[]
  deletedSuggestedRoles DeletedSuggestedRole[]
  interviewRounds       InterviewRound[]
  interviewQuestions    InterviewQuestion[]
  prepChecklistItems    PrepChecklistItem[]
  starStories           StarStory[]
  offers                Offer[]
  negotiationSteps      NegotiationStep[]
  networkingOutreach    NetworkingOutreach[]
  careerTargets         CareerTarget[]
  careerSkills          CareerSkill[]
  careerCertifications  CareerCertification[]
  careerProjects        CareerProject[]
  careerSalaryEntries   CareerSalaryEntry[]
  careerGoals           CareerGoal[]
  careerWeeklyReviews   CareerWeeklyReview[]
  careerJournalEntries  CareerJournalEntry[]
  careerMentors         CareerMentor[]
  careerReviews         CareerReview[]
  resumes               Resume[]

  bodyMetrics          BodyMetric[]
  vitalReadings        VitalReading[]
  nutritionDays        NutritionDay[]
  foodProducts         FoodProduct[]
  nutritionGoal        NutritionGoal?
  savedMeals           SavedMeal[]
  waterLogs            WaterLog[]
  sleepEntries         SleepEntry[]
  habits               Habit[]
  journalEntries       JournalEntry[]
  medicalRecords       MedicalRecord[]
  progressPhotos       ProgressPhoto[]
  substanceLogs        SubstanceLog[]
  customSubstanceTypes CustomSubstanceType[]
  sobrietyCounters     SobrietyCounter[]
  providers            Provider[]
  doctors              Doctor[]

  peptides             Peptide[]
  medications          Medication[]
  supplements          Supplement[]
  therapeuticSchedules TherapeuticSchedule[]
  therapeuticDoses     TherapeuticDose[]
  therapeuticLogs      TherapeuticLog[]

  exercises        Exercise[]
  workouts         Workout[]
  templates        Template[]
  personalRecords  PersonalRecord[]
  trainingCycles   TrainingCycle[]
  bodyMeasurements BodyMeasurement[]
  workoutSchedules WorkoutSchedule[]
  todoRoutines     TodoRoutine[]

  finAccounts       FinAccount[]
  creditCards       CreditCard[]
  brokerageAccounts BrokerageAccount[]
  finStatements     FinStatement[]
  finTransactions   FinTransaction[]
  budgetCategories  BudgetCategory[]
  finSubscriptions  FinSubscription[]
  institutions      Institution[]
  financialPlans    FinancialPlan[]
  incomeStreams     IncomeStream[]
  incomeEntries     IncomeEntry[]
  netWorthSnapshots NetWorthSnapshot[]
  taxDocuments      TaxDocument[]
  debts             Debt[]
  creditScores      CreditScoreEntry[]
  financialGoals    FinancialGoal[]

  socialContacts     SocialContact[]
  socialEvents       SocialEvent[]
  socialBatteries    SocialBattery[]
  socialTags         SocialTag[]
  outreachDrafts     OutreachDraft[]
  recurringReminders RecurringReminder[]

  learningCourses      LearningCourse[]
  learningGoals        LearningGoal[]
  learningSkills       LearningSkill[]
  learningResources    LearningResource[]
  flashcards           Flashcard[]
  quizzes              Quiz[]
  learningNotes        LearningNote[]
  learningSessions     LearningSession[]
  learningPlanEntries  LearningPlanEntry[]
  learningAchievements LearningAchievement[]
  learningClasses      LearningClass[]
  videoGroups          VideoGroup[]
  archiveVideos        ArchiveVideo[]
  learningShares       LearningShare[]

  focusSprints     FocusSprint[]
  weeklyPriorities WeeklyPriority[]
  rewardGoals      RewardGoal[]
  goalPeriods      GoalPeriod[]
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model UserProfile {
  id                   String    @id @default(cuid())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String    @unique
  gender               String?
  birthdate            DateTime?
  heightCm             Float?
  activityLevel        String?
  dietGoal             String?
  targetWeeklyChangeKg Float?
  goalWeightKg         Float?
  goalBodyFatPct       Float?
  goalTargetDate       DateTime?
  waterGoalMl          Int?      @default(2500)
  phone                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Alpaca brokerage link (READ-ONLY portfolio view; no trading actions).
model AlpacaConnection {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String   @unique
  activePaper    Boolean  @default(true)
  paperApiKey    String?
  paperApiSecret String?
  liveApiKey     String?
  liveApiSecret  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Plaid bank link — one row per connected institution (Item).
model PlaidItem {
  id                 String         @id @default(cuid())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  itemId             String         @unique // Plaid item_id
  accessToken        String
  institutionId      String? // Plaid institution_id
  institutionName    String?
  transactionsCursor String?
  lastSyncedAt       DateTime?
  lastAccountsSyncAt DateTime?
  status             String         @default("good")
  errorCode          String?
  accounts           PlaidAccount[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
}

/// Maps a Plaid account to a LifeOS FinAccount or CreditCard.
model PlaidAccount {
  id                String      @id @default(cuid())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  plaidItem         PlaidItem   @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  plaidItemId       String
  plaidAccountId    String      @unique // Plaid account_id
  name              String
  officialName      String?
  mask              String?
  type              String // depository | credit | loan | investment | brokerage | other
  subtype           String?
  finAccount        FinAccount? @relation(fields: [finAccountId], references: [id], onDelete: SetNull)
  finAccountId      String?     @unique
  creditCard        CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardId      String?     @unique
  balanceCurrent    Decimal?    @db.Decimal(14, 2)
  balanceAvailable  Decimal?    @db.Decimal(14, 2)
  balanceLimit      Decimal?    @db.Decimal(14, 2)
  lastBalanceSyncAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([plaidItemId])
}

/// Spotify account link (OAuth tokens for playback control + playlists).
model SpotifyConnection {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  spotifyUserId String
  displayName   String?
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  scope         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Genius account link (OAuth token for lyrics search; app client-credentials also used).
model GeniusConnection {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  geniusUserId String?
  displayName  String?
  accessToken  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                     String     @id @default(cuid())
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String     @unique
  unitSystem             UnitSystem @default(IMPERIAL)
  aiEnabled              Boolean    @default(false)
  aiModel                String?
  aiBudgetUsd            Decimal?   @db.Decimal(8, 2)
  aiMonthSpend           Decimal    @default(0) @db.Decimal(8, 2)
  // Refined AI spend caps (enforced at call time). Null = unlimited.
  aiMonthlyLimitUsd      Decimal?   @db.Decimal(8, 2)
  aiPerSearchLimitUsd    Decimal?   @db.Decimal(8, 2)
  // Appearance prefs (cross-device persistence; mirrored to localStorage for no-FOUC).
  accent                 String?
  moduleAccents          Json?
  dateFormat             String?
  timeFormat             String?
  currency               String?
  coachStyle             String?
  sidebarConfig          Json?
  scoreWeights           Json?
  lastSubscriptionScanAt DateTime? // monthly auto-run marker for AI subscription detection
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

// ============================================================
// Cross-cutting: notifications, todos, AI telemetry, insights
// ============================================================

enum NotificationKind {
  SYSTEM
  AI_SUGGESTION
  ALERT
  TODO_DUE
  INTEGRATION
}

enum NotificationSeverity {
  INFO
  WARN
  DANGER
  SUCCESS
}

model Notification {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      NotificationKind     @default(SYSTEM)
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, readAt])
}

enum TodoSource {
  USER
  AI
  INTEGRATION
}

enum TodoStatus {
  PLANNED
  IN_PROGRESS
  DRIPPED
  DONE
  SKIPPED
}

enum TodoCadence {
  DAILY
  EVERY_N_DAYS
  WEEKLY_DOW
  YEARLY
}

/// Coarse part-of-day bucket for a todo. Used as a tag/badge and to "float"
/// untimed todos into a zone band on the calendar (Morning 6–12, Afternoon
/// 12–17, Evening 17–21, Night 21–24).
enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

/// Priority flag — drives sort order + a color-coded left border on cards.
enum TodoPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Energy-level tag for energy-aware scheduling.
enum TodoEnergy {
  DEEP_WORK
  QUICK
  COLLABORATIVE
}

/// Recurring todo definition — materialized into one TodoItem per due day.
model TodoRoutine {
  id              String       @id @default(cuid())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  title           String
  body            String?
  cadence         TodoCadence  @default(DAILY)
  intervalN       Int? // EVERY_N_DAYS
  daysOfWeek      String[]     @default([]) // MON..SUN for WEEKLY_DOW
  yearlyMonth     Int? // 1-12 for YEARLY
  yearlyDay       Int? // 1-31 for YEARLY
  active          Boolean      @default(true)
  endDate         DateTime?    @db.Date // recurring stop date (inclusive); nothing materialized after
  anchorDate      DateTime?    @db.Date // EVERY_N_DAYS start anchor (defaults to createdAt day)
  // Scheduling + classification defaults copied onto each materialized TodoItem.
  timeOfDay       TimeOfDay? // part-of-day bucket
  startTime       String? // "HH:MM" 24h wall-clock; null = no specific time
  durationMinutes Int? // estimated minutes to complete (block sizing)
  priority        TodoPriority @default(NONE)
  category        String? // color-coded category
  energy          TodoEnergy?
  tags            String[]     @default([])
  items           TodoItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, active])
}

model TodoItem {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  title             String
  body              String?
  source            TodoSource       @default(USER)
  status            TodoStatus       @default(PLANNED)
  date              DateTime?        @db.Date // the day this todo belongs to (per-day model)
  // Rich scheduling metadata (all optional, backward compatible).
  timeOfDay         TimeOfDay? // part-of-day bucket — tag/badge + zone-band placement
  startTime         String? // "HH:MM" 24h wall-clock for calendar block position; null = no specific time
  durationMinutes   Int? // estimated minutes to complete — drives block height + daily capacity
  // Classification + organization.
  priority          TodoPriority     @default(NONE)
  tags              String[]         @default([]) // freeform/preset labels (e.g. CoreMarketing, Admin)
  category          String? // color-coded category (Personal/Work/Finance/Health/...)
  energy            TodoEnergy? // energy-aware scheduling tag
  sortOrder         Int              @default(0) // manual ordering within a status column
  links             String[]         @default([]) // pasted reference URLs
  projectRef        String? // linked project/client label
  projectUrl        String? // linked project/client URL
  rolledOver        Boolean          @default(false) // carried over from a previous day
  // Dependency: this todo is blocked until `blockedBy` is done.
  blockedBy         TodoItem?        @relation("TodoBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  blockedById       String?
  blockers          TodoItem[]       @relation("TodoBlockedBy")
  subtasks          TodoSubtask[]
  routine           TodoRoutine?     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  routineId         String?
  plannedAt         DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  hindrance         String?
  calendarEvent     CalendarEvent?   @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  calendarEventId   String?
  therapeuticDose   TherapeuticDose? @relation(fields: [therapeuticDoseId], references: [id], onDelete: SetNull)
  therapeuticDoseId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([routineId, date])
  @@index([userId, status])
  @@index([userId, date])
  @@index([blockedById])
}

/// A checklist subtask under a TodoItem.
model TodoSubtask {
  id        String   @id @default(cuid())
  todo      TodoItem @relation(fields: [todoId], references: [id], onDelete: Cascade)
  todoId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([todoId])
}

model AiCall {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  provider     String
  model        String
  purpose      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs    Int?
  errored      Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

enum LifeDomain {
  HEALTH
  CAREER
  FINANCIAL
  LEARNING
  SOCIAL
  OVERALL
}

model Insight {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  domain    LifeDomain
  type      String?
  message   String
  createdAt DateTime   @default(now())

  @@index([userId, domain])
}

model ScoreSnapshot {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  domain       LifeDomain
  score        Float
  calculatedOn DateTime   @db.Date
  createdAt    DateTime   @default(now())

  @@index([userId, domain, calculatedOn])
}

// ============================================================
// Calendar
// ============================================================

enum EventKind {
  EVENT
  APPOINTMENT
}

enum RsvpStatus {
  PENDING
  YES
  NO
  MAYBE
}

enum ReminderChannel {
  INAPP
  EMAIL
}

/// Recurring life reminder (haircut, dentist...) independent of one-off calendar events.
enum ReminderCadence {
  ONCE
  EVERY_N_DAYS
  WEEKLY
  MONTHLY_ON_DAY
  EVERY_N_MONTHS
}

model RecurringReminder {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  title           String
  description     String?
  location        String?
  icon            String? // @untitledui/icons component name
  contact         SocialContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId       String?
  phone           String?
  link            String?
  cadence         ReminderCadence @default(ONCE)
  intervalN       Int? // every N days / months
  dayOfMonth      Int? // for MONTHLY_ON_DAY
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  archived        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, nextDueAt, archived])
}

model EventCategory {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  color     String          @default("neutral") // red | emerald | sky | violet | amber | neutral
  icon      String?
  events    CalendarEvent[]
  createdAt DateTime        @default(now())

  @@index([userId])
}

model CalendarEvent {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  kind        EventKind       @default(EVENT)
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean         @default(false)
  category    EventCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  // Appointment-specific
  provider    Provider?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId  String?
  doctor      Doctor?         @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId    String?
  visitNotes  String?
  rrule       String?
  attendees   EventAttendee[]
  reminders   EventReminder[]
  records     MedicalRecord[]
  todoItems   TodoItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, startsAt])
}

model EventAttendee {
  id        String         @id @default(cuid())
  event     CalendarEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  contact   SocialContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
  email     String?
  name      String?
  rsvp      RsvpStatus     @default(PENDING)

  @@index([eventId])
}

model EventReminder {
  id            String          @id @default(cuid())
  event         CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  minutesBefore Int
  channel       ReminderChannel @default(INAPP)
  firesAt       DateTime?
  sentAt        DateTime?

  @@index([eventId])
}

// ============================================================
// Jobs (application tracker)
// ============================================================

enum JobStatus {
  NOT_STARTED
  APPLIED
  UNDER_REVIEW
  ASSESSMENT
  INTERVIEWING
  OFFERED
  OFFER_ACCEPTED
  OFFER_DECLINED
  REJECTED
  GHOSTED
  WITHDRAWN
}

enum WorkType {
  HYBRID
  REMOTE
  IN_OFFICE
  NA
}

enum JobDocumentKind {
  RESUME
  COVER_LETTER
  CERTIFICATION
  EDUCATION
  CAREER_OTHER
}

enum ContactMethod {
  LINKEDIN
  EMAIL
  PHONE
  DISCORD
}

model Company {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  name            String
  logoKey         String?
  hqLocation      String?
  officeLocations String[] @default([])
  websiteDomain   String?
  linkedinUrl     String?
  industry        String?
  size            String?
  notesMarkdown   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applications       JobApplication[]
  contacts           JobContact[]
  salaryEntries      CareerSalaryEntry[]
  leads              JobLead[]
  suggestedOrigins   SuggestedCompany[]
  interviewQuestions InterviewQuestion[]
  networkingOutreach NetworkingOutreach[]

  @@index([userId, name])
}

model JobPhase {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  archived     Boolean          @default(false)
  startedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]

  @@index([userId, archived])
}

model JobApplication {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  applicationUrl String?
  role           String
  dateApplied    DateTime?
  status         JobStatus @default(NOT_STARTED)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?   @default("USD")
  location       String?
  workType       WorkType  @default(NA)
  heardFrom      String?
  deadline       DateTime?
  notesMarkdown  String?

  // --- Power features ---
  priority           Int       @default(0) // 0 none · 1 backup · 2 interested · 3 dream
  jdText             String? // archived original job description text
  thankYouSent       Boolean   @default(false) // overall post-interview courtesy flag
  lastActivityAt     DateTime? // bumped on every logged event (for ghosting / health)
  atsScore           Int? // last ATS keyword match score (0-100)
  atsMissingKeywords String[]  @default([]) // keywords missing vs resume on last analysis

  // Referral (who referred you in)
  referredByName         String?
  referredByRelationship String?
  referredBy             JobContact? @relation("ReferralContact", fields: [referredByContactId], references: [id], onDelete: SetNull)
  referredByContactId    String?

  // Career goal alignment
  target   CareerTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  targetId String?

  // Set when promoted from an AI JobLead: which saved search location it is
  // nearest to, and how far (miles). Powers the location filter on the list.
  nearestLocation   JobSearchLocation? @relation(fields: [nearestLocationId], references: [id], onDelete: SetNull)
  nearestLocationId String?
  distanceMiles     Float?

  resumeVersion        JobDocumentVersion? @relation("ApplicationResume", fields: [resumeVersionId], references: [id])
  resumeVersionId      String?
  coverLetterVersion   JobDocumentVersion? @relation("ApplicationCoverLetter", fields: [coverLetterVersionId], references: [id])
  coverLetterVersionId String?

  phase   JobPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  phaseId String?

  meetings        JobMeeting[]
  attachments     JobAttachment[]
  events          JobApplicationEvent[]
  salaryEntries   CareerSalaryEntry[]
  lead            JobLead?
  interviewRounds InterviewRound[]
  prepItems       PrepChecklistItem[]
  questions       InterviewQuestion[]
  offers          Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([companyId])
  @@index([phaseId])
  @@index([nearestLocationId])
  @@index([targetId])
  @@index([referredByContactId])
}

model JobApplicationEvent {
  id            String         @id @default(cuid())
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          String // created | updated | status | meeting | attachment
  message       String
  fromStatus    JobStatus?
  toStatus      JobStatus?
  createdAt     DateTime       @default(now())

  @@index([applicationId])
}

model JobDocument {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  kind      JobDocumentKind
  versions  JobDocumentVersion[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([userId, kind])
}

model JobDocumentVersion {
  id            String      @id @default(cuid())
  document      JobDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  versionNumber Int
  label         String?
  fileKey       String
  fileName      String
  fileSize      Int
  mimeType      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  usedAsResume      JobApplication[] @relation("ApplicationResume")
  usedAsCoverLetter JobApplication[] @relation("ApplicationCoverLetter")

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model JobMeeting {
  id               String         @id @default(cuid())
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId    String
  type             String?
  durationMinutes  Int?
  dateTime         DateTime?
  location         String?
  notesMarkdown    String?
  participantNames String[]       @default([])

  participants JobContact[]    @relation("MeetingParticipants")
  attachments  JobAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
}

model JobContact {
  id                     String          @id @default(cuid())
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  name                   String
  company                Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId              String?
  role                   String?
  kind                   JobContactKind?
  preferredContactMethod ContactMethod?
  email                  String?
  phone                  String?
  linkedinUrl            String?
  discord                String?
  pronouns               String?
  location               String?
  timezone               String?
  lastContactedAt        DateTime?
  notesMarkdown          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  interactions         JobContactInteraction[]
  meetings             JobMeeting[]            @relation("MeetingParticipants")
  referredApplications JobApplication[]        @relation("ReferralContact")
  networkingOutreach   NetworkingOutreach[]

  @@index([userId, name])
  @@index([companyId])
}

model JobContactInteraction {
  id        String         @id @default(cuid())
  contact   JobContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  date      DateTime       @default(now())
  channel   ContactMethod?
  note      String?
  createdAt DateTime       @default(now())

  @@index([contactId])
}

model JobAttachment {
  id        String   @id @default(cuid())
  fileKey   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String?
  meeting       JobMeeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId     String?

  @@index([applicationId])
  @@index([meetingId])
}

// ============================================================
// AI job search (saved locations, search profile, AI-found leads)
// ============================================================

enum JobLevel {
  INTERNSHIP
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  UNKNOWN
}

///
/// Lifecycle of an AI-found role or company suggestion.
/// 
enum SuggestionStatus {
  NEW // freshly suggested, awaiting the user's decision
  DISMISSED // user removed it; kept so it is not re-suggested
  ADDED // user promoted it (lead -> application, company -> tracked company)
}

///
/// A place the user wants to search for jobs near (geocoded via Nominatim).
/// 
model JobSearchLocation {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  label       String // full display name, e.g. "Chicago, Illinois, United States"
  shortLabel  String? // compact name, e.g. "Chicago, IL"
  lat         Float
  lon         Float
  placeType   String? // Nominatim addresstype: city | postcode | town | ...
  countryCode String?
  priority    Int      @default(0) // lower = searched first / higher priority
  maxResults  Int      @default(50) // how many roles to try to load for this location
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  leads        JobLead[]
  applications JobApplication[]

  @@index([userId])
}

///
/// Single per-user job-search configuration (keywords, profile, distance, remote).
/// 
model JobSearchProfile {
  id                  String     @id @default(cuid())
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String     @unique
  profileText         String? // free-text "about me", e.g. "Computer science graduate ..."
  keywords            String[]   @default([]) // roles/skills to look for
  excludeKeywords     String[]   @default([]) // terms to avoid
  levels              JobLevel[] @default([]) // empty = any level
  distanceMiles       Int        @default(50) // 25 | 50 | 100 search radius
  allowRemote         Boolean    @default(true)
  includeNewCompanies Boolean    @default(true) // also surface companies not yet tracked
  minSalary           Int? // optional salary floor (in profile currency)
  resultsPerLocation  Int        @default(50) // default per-location target
  // Automation thresholds
  autoGhost           Boolean    @default(false) // auto-flag silent applications as ghosted
  ghostAfterDays      Int        @default(21) // days of silence before auto-ghost
  followUpAfterDays   Int        @default(7) // days of silence before a follow-up nudge
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

///
/// An AI-discovered company that is NOT yet tracked; user adds or dismisses it.
/// 
model SuggestedCompany {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  websiteDomain     String?
  logoKey           String?
  industry          String?
  hqLocation        String?
  size              String?
  status            SuggestionStatus @default(NEW)
  promotedCompany   Company?         @relation(fields: [promotedCompanyId], references: [id], onDelete: SetNull)
  promotedCompanyId String?
  createdAt         DateTime         @default(now())

  leads JobLead[]

  @@index([userId, status])
  @@index([userId, name])
}

///
/// An AI-discovered job opening. Lives in the "AI suggested" tables until the user
/// promotes it to a real JobApplication (status -> ADDED) or dismisses it.
/// 
model JobLead {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Company identity: either an already-tracked Company or a SuggestedCompany.
  // companyName/companyDomain are denormalized so leads render without a join.
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String?
  suggestedCompany   SuggestedCompany? @relation(fields: [suggestedCompanyId], references: [id], onDelete: Cascade)
  suggestedCompanyId String?
  companyName        String
  companyDomain      String?

  title              String
  level              JobLevel  @default(UNKNOWN)
  descriptionSnippet String?
  applicationUrl     String?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?   @default("USD")
  deadline           DateTime?
  locationText       String?
  lat                Float?
  lon                Float?
  isRemote           Boolean   @default(false)

  nearestLocation   JobSearchLocation? @relation(fields: [nearestLocationId], references: [id], onDelete: SetNull)
  nearestLocationId String?
  distanceMiles     Float?

  matchScore  Int? // 0-100 fit against the search profile
  matchReason String? // short rationale / qualification note

  status                SuggestionStatus @default(NEW)
  promotedApplication   JobApplication?  @relation(fields: [promotedApplicationId], references: [id], onDelete: SetNull)
  promotedApplicationId String?          @unique

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([companyId])
  @@index([suggestedCompanyId])
  @@index([nearestLocationId])
}

///
/// Tracks one AI job-search run so the UI can show live progress, estimate vs actual
/// cost/count, and HALT a run in flight (the worker checks cancelRequested between passes).
/// status: queued | running | done | cancelled | error.
/// 
model JobSearchRun {
  id               String    @id @default(cuid())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  status           String    @default("queued")
  params           Json?
  targetCount      Int       @default(50)
  foundCount       Int       @default(0)
  estimatedCostUsd Decimal   @default(0) @db.Decimal(10, 6)
  actualCostUsd    Decimal   @default(0) @db.Decimal(10, 6)
  cancelRequested  Boolean   @default(false)
  progress         Json?
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}

///
/// Backup of dismissed/removed AI-suggested roles. Suggested roles are NEVER hard-deleted;
/// they move here and are only purged via Settings. Mirrors JobLead's display fields.
/// 
model DeletedSuggestedRole {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  companyName        String
  companyDomain      String?
  title              String
  level              String   @default("UNKNOWN")
  descriptionSnippet String?
  applicationUrl     String?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?  @default("USD")
  locationText       String?
  lat                Float?
  lon                Float?
  isRemote           Boolean  @default(false)
  matchScore         Int?
  matchReason        String?
  originalStatus     String   @default("NEW")
  deletedAt          DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([userId, deletedAt])
}

///
/// Global cache of place-string -> coordinates so we geocode each city once.
/// 
model GeocodeCache {
  id          String   @id @default(cuid())
  query       String   @unique
  lat         Float?
  lon         Float?
  displayName String?
  createdAt   DateTime @default(now())
}

// ============================================================
// Career power features: interviews, prep, offers, networking, goals
// ============================================================

enum InterviewFormat {
  PHONE
  VIDEO
  ONSITE
  TAKE_HOME
  PANEL
  OTHER
}

enum RoundOutcome {
  PENDING
  PASSED
  FAILED
  CANCELLED
  NO_SHOW
  WITHDREW
}

enum OfferStatus {
  RECEIVED
  NEGOTIATING
  ACCEPTED
  DECLINED
  RESCINDED
  EXPIRED
}

enum NegotiationKind {
  INITIAL
  COUNTER
  REVISED
  FINAL
}

enum JobContactKind {
  RECRUITER
  HIRING_MANAGER
  REFERRAL
  INTERVIEWER
  TEAM_MEMBER
  OTHER
}

///
/// One interview round for an application (Round 1, 2, …, Final).
/// 
model InterviewRound {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  application      JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId    String
  roundNumber      Int             @default(1)
  name             String? // e.g. "Recruiter screen", "Final onsite"
  format           InterviewFormat @default(VIDEO)
  scheduledAt      DateTime?
  durationMinutes  Int?
  outcome          RoundOutcome    @default(PENDING)
  selfRating       Int? // 1-5 self score
  interviewerNames String[]        @default([])
  notesMarkdown    String? // private reflection: what went well / poorly
  thankYouSent     Boolean         @default(false)
  thankYouSentAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  questions InterviewQuestion[]

  @@index([applicationId])
  @@index([userId])
}

///
/// A question asked in an interview, with your stored answer for reuse.
/// 
model InterviewQuestion {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId String?
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  round         InterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  roundId       String?
  question      String
  answer        String?
  category      String? // behavioral | technical | system-design | culture | other
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([applicationId])
  @@index([companyId])
}

///
/// A per-application interview-prep checklist item.
/// 
model PrepChecklistItem {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  label         String
  done          Boolean        @default(false)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([applicationId])
}

///
/// A reusable behavioral STAR story.
/// 
model StarStory {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  situation String?
  task      String?
  action    String?
  result    String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

///
/// A job offer attached to an application (for the comparison table).
/// 
model Offer {
  id                String         @id @default(cuid())
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  application       JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId     String
  status            OfferStatus    @default(RECEIVED)
  baseSalary        Int?
  bonus             Int? // target annual bonus
  equityValue       Int? // annualized equity estimate
  equityDescription String?
  signOnBonus       Int?
  ptoDays           Int?
  currency          String         @default("USD")
  benefits          String? // free text / markdown
  location          String?
  remote            Boolean?
  startDate         DateTime?
  decisionDeadline  DateTime?
  notesMarkdown     String?
  letterFileKey     String? // uploaded offer letter
  letterFileName    String?
  receivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  negotiationSteps NegotiationStep[]

  @@index([userId])
  @@index([applicationId])
}

///
/// One step in negotiating an offer (initial → counter → final).
/// 
model NegotiationStep {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  offer       Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId     String
  kind        NegotiationKind @default(COUNTER)
  date        DateTime?
  baseSalary  Int?
  bonus       Int?
  equityValue Int?
  rationale   String?
  outcome     String?
  createdAt   DateTime        @default(now())

  @@index([offerId])
}

///
/// A networking outreach touch (cold message, intro request, etc.).
/// 
model NetworkingOutreach {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  contact       JobContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId     String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  personName    String // denormalized for quick entry
  channel       ContactMethod?
  sentAt        DateTime?
  responded     Boolean        @default(false)
  respondedAt   DateTime?
  converted     Boolean        @default(false) // turned into a real conversation / referral
  notesMarkdown String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([contactId])
  @@index([companyId])
}

///
/// A career target on the goals board; applications can align to one.
/// 
model CareerTarget {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  title             String
  targetRole        String?
  targetCompanyType String?
  targetSalary      Int?
  targetLocation    String?
  notesMarkdown     String?
  isPrimary         Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications JobApplication[]

  @@index([userId])
}

// ============================================================
// Career extras (skills, certs, salary, mentors, resume builder)
// ============================================================

model CareerSkill {
  id                String                @id @default(cuid())
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  category          String?
  proficiency       Int?
  targetProficiency Int?
  practicePlan      String?
  proofUrl          String?
  hoursLogged       Float                 @default(0)
  evidence          CareerSkillEvidence[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId])
}

model CareerSkillEvidence {
  id           String      @id @default(cuid())
  skill        CareerSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      String
  evidenceUrl  String?
  evidenceType String?
  description  String?
  createdAt    DateTime    @default(now())

  @@index([skillId])
}

model CareerCertification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  issuer      String?
  status      String? // planned | in_progress | completed
  examDate    DateTime?
  completedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model CareerProject {
  id                String    @id @default(cuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  description       String?
  role              String?
  technologies      String[]  @default([])
  startedOn         DateTime?
  completedOn       DateTime?
  impactDescription String?
  url               String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

model CareerSalaryEntry {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  date          DateTime
  company       String? // legacy free-text
  companyRef    Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId String?
  title         String?
  baseSalary    Decimal         @default(0) @db.Decimal(14, 2)
  bonus         Decimal         @default(0) @db.Decimal(14, 2)
  equity        Decimal         @default(0) @db.Decimal(14, 2)
  totalComp     Decimal         @default(0) @db.Decimal(14, 2)
  currency      String          @default("USD")
  createdAt     DateTime        @default(now())

  @@index([userId, date])
}

model CareerGoal {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  status      String? // active | completed | abandoned
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model CareerWeeklyReview {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  weekOf        DateTime @db.Date
  wins          String?
  challenges    String?
  learning      String?
  goalsProgress Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, weekOf])
}

model CareerJournalEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime @db.Date
  entry     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model CareerMentor {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  name            String
  expertise       String?
  contactInfo     String?
  lastMeetingDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model CareerReview {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  reviewDate   DateTime
  reviewerName String?
  rating       Float?
  feedback     String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

enum ResumeItemKind {
  EXPERIENCE
  PROJECT
  EDUCATION
  VOLUNTEER
  SKILL
  CERTIFICATION
  AWARD
  ORGANIZATION
}

model Resume {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String       @default("Resume")
  headline  String?
  summary   String?
  items     ResumeItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model ResumeItem {
  id          String         @id @default(cuid())
  resume      Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId    String
  kind        ResumeItemKind
  order       Int            @default(0)
  title       String
  subtitle    String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean        @default(false)
  description String?
  url         String?
  meta        Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([resumeId, kind])
}

// ============================================================
// Health: metrics, vitals, nutrition, sleep, habits, journal,
// medical, photos, substances
// ============================================================

model BodyMetric {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  metricType String // weight | body_fat_pct | custom | ...
  customName String?
  value      Float
  unit       String?
  measuredAt DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, metricType, measuredAt])
}

model VitalReading {
  id         String              @id @default(cuid())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  vitalType  String // blood_pressure | heart_rate | temperature | spo2 | custom
  customName String?
  value      Float?
  value2     Float?
  unit       String?
  measuredAt DateTime
  notes      String?
  fields     VitalReadingField[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId, vitalType, measuredAt])
