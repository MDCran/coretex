  reading   VitalReading @relation(fields: [readingId], references: [id], onDelete: Cascade)
  readingId String
  label     String
  unit      String?
  value     Float
  position  Int          @default(0)

  @@index([readingId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  TEXT
  BARCODE
  VISION
  MANUAL
}

model NutritionDay {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  date      DateTime @db.Date
  notes     String?
  meals     Meal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Meal {
  id        String       @id @default(cuid())
  day       NutritionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId     String
  mealType  MealType
  name      String?
  order     Int          @default(0)
  entries   FoodEntry[]
  loggedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([dayId])
}

model FoodEntry {
  id               String       @id @default(cuid())
  meal             Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId           String
  product          FoodProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId        String?
  description      String
  source           FoodSource   @default(MANUAL)
  servingSize      String?
  quantity         Float?
  unit             String?
  calories         Float?
  proteinG         Float?
  carbsG           Float?
  fatG             Float?
  fiberG           Float?
  sugarG           Float?
  sodiumMg         Float?
  cholesterolMg    Float?
  saturatedFatG    Float?
  transFatG        Float?
  potassiumMg      Float?
  aiAnalyzed       Boolean      @default(false)
  aiRawResponse    Json?
  manuallyAdjusted Boolean      @default(false)
  confidence       Float?
  imageKey         String?
  order            Int          @default(0)
  isFavorite       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([mealId])
}

model FoodProduct {
