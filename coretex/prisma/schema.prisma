}

// ============================================================
// Peptides & therapeutics
// ============================================================

model Peptide {
  id                    String         @id @default(cuid())
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  name                  String
  vialMg                Float
  doseUnit              String         @default("mg") // mg | mcg
  waterMl               Float
  syringeUnitsPerMl     Int            @default(100) // 100 | 50 | 40
  vialsOwned            Float          @default(0)
  vialsOpened           Int            @default(0)
  activeVialRemainingMl Float          @default(0)
  cycleStartDate        DateTime?      @db.Date
  position              Int            @default(0)
  blocks                PeptideBlock[]
  logs                  PeptideLog[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([userId, position])
}

model PeptideBlock {
  id           String       @id @default(cuid())
  peptide      Peptide      @relation(fields: [peptideId], references: [id], onDelete: Cascade)
  peptideId    String
  startWeek    Int
  endWeek      Int
  dosePerAdmin Float
  dosesPerWeek Float
  note         String?
  order        Int          @default(0)
  logs         PeptideLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([peptideId])
}

model PeptideLog {
  id        String        @id @default(cuid())
  peptide   Peptide       @relation(fields: [peptideId], references: [id], onDelete: Cascade)
  peptideId String
  block     PeptideBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  blockId   String?
  date      DateTime      @db.Date
  dose      Float
  units     Float
  mlUsed    Float
  site      String?
  createdAt DateTime      @default(now())

  @@index([peptideId, date])
}

model Medication {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  dosageAmount Float?
  dosageUnit   String?
  frequency    String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, active])
}

model Supplement {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  dosageAmount Float?
  dosageUnit   String?
  frequency    String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, active])
}

enum TherapeuticKind {
  MEDICATION
  SUPPLEMENT
  PEPTIDE
  OTHER
}

enum SchedulePattern {
  DAILY
  EVERY_N_DAYS
  WEEKLY_DOW
  WEEKLY_ONCE
}

model TherapeuticSchedule {
  id         String            @id @default(cuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       TherapeuticKind
  name       String
  dosage     String?
  notes      String?
  startDate  DateTime?         @db.Date
  endDate    DateTime?         @db.Date
  pattern    SchedulePattern   @default(DAILY)
  everyN     Int?
  daysOfWeek String[]          @default([]) // MON..SUN
  timesOfDay String[]          @default([]) // HH:mm
  archived   Boolean           @default(false)
  doses      TherapeuticDose[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, archived])
}

model TherapeuticDose {
  id          String               @id @default(cuid())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  schedule    TherapeuticSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId  String?
  scheduledAt DateTime
  loggedAt    DateTime?
  skippedAt   DateTime?
  notes       String?
  todoItem    TodoItem?
  createdAt   DateTime             @default(now())

  @@unique([scheduleId, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([scheduleId])
}

model TherapeuticLog {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  therapeuticKind TherapeuticKind
  therapeuticId   String? // loose FK to Medication/Supplement/Peptide
  name            String?
  doseAmount      Float?
  doseUnit        String?
  loggedAt        DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([userId, loggedAt])
}

// ============================================================
// Workouts
// ============================================================

enum ExerciseForce {
  PUSH
  PULL
  STATIC
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum ExerciseMechanic {
  COMPOUND
  ISOLATION
}

enum MediaType {
  IMAGE
  VIDEO
}

model Exercise {
  id               String            @id @default(cuid())
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String? // null = global/catalog exercise
  name             String
  slug             String            @unique
  muscles          String[]          @default([])
  secondaryMuscles String[]          @default([])
  equipment        String[]          @default([])
  parent           Exercise?         @relation("ExerciseVariations", fields: [parentId], references: [id], onDelete: SetNull)
  parentId         String?
  variations       Exercise[]        @relation("ExerciseVariations")
  instructions     String?
  instructionSteps String[]          @default([])
  notes            String?
  mediaUrl         String?
  mediaKey         String?
  mediaType        MediaType?
  images           String[]          @default([])
  force            ExerciseForce?
  level            ExerciseLevel?
  mechanic         ExerciseMechanic?
  category         String?
  externalId       String?           @unique
  tracksReps       Boolean           @default(true)
  tracksWeight     Boolean           @default(true)
  tracksTime       Boolean           @default(false)
  tracksDistance   Boolean           @default(false)
  archived         Boolean           @default(false)
  archivedAt       DateTime?

  workoutExercises  WorkoutExercise[]
  templateExercises TemplateExercise[]
  personalRecords   PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

enum ProgressionScheme {
  NONE
  LINEAR
  DOUBLE
  FIVETHREEONE
}

model Template {
  id                String             @id @default(cuid())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  note              String?
  progression       ProgressionScheme  @default(NONE)
  progressionStepKg Float?
  cycleWeek         Int?
  archived          Boolean            @default(false)
  exercises         TemplateExercise[]
  workouts          Workout[]
  schedules         WorkoutSchedule[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, archived])
}

model TemplateExercise {
  id              String        @id @default(cuid())
  template        Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId      String
  exercise        Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId      String
  order           Int           @default(0)
  targetSets      Int?
  targetReps      Int?
  targetRepsMin   Int?
  targetRepsMax   Int?
  targetWeight    Float?
  trainingMaxKg   Float?
  targetTimeSec   Int?
  targetDistanceM Float?
  note            String?
  restSec         Int?
  warmupSets      Json?
  groupKey        String? // superset letter A-Z
  targetRpe       Float?
  tempo           String? // ecc-pause-conc-rest
  perSetMode      Boolean       @default(false)
  sets            TemplateSet[]

  @@index([templateId])
  @@index([exerciseId])
}

model TemplateSet {
  id                 String           @id @default(cuid())
  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)
  templateExerciseId String
  order              Int              @default(0)
  targetReps         Int?
  targetRepsMin      Int?
  targetRepsMax      Int?
  targetWeight       Float?
  targetRpe          Float?
  isAmrap            Boolean          @default(false)
  isWarmup           Boolean          @default(false)

  @@index([templateExerciseId])
}

model Workout {
  id         String            @id @default(cuid())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String?
  note       String?
  rpe        Float?
  date       DateTime          @db.Date
  startedAt  DateTime?
  endedAt    DateTime?
  ///
  /// Accumulated paused milliseconds (durable across reloads).
  ///
  pausedMs   Int               @default(0)
  ///
  /// Timestamp the current pause began; null when the session is running.
  ///
  pausedAt   DateTime?
  template   Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  exercises  WorkoutExercise[]
  photos     ProgressPhoto[]
  schedule   WorkoutSchedule?
  deletedAt  DateTime?
  ///
  /// Standalone exercise attempts — hidden from workout log/lists but counted in PRs & history.
  ///
  isQuickLog Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, date])
}

model WorkoutExercise {
  id         String     @id @default(cuid())
  workout    Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId  String
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String
  order      Int        @default(0)
  note       String?
  groupKey   String?
  restSec    Int?
  tempo      String?
  sets       SetEntry[]

  @@index([workoutId])
  @@index([exerciseId])
}

model SetEntry {
  id                String          @id @default(cuid())
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  workoutExerciseId String
  order             Int             @default(0)
  targetReps        Int?
  actualReps        Int?
  targetWeight      Float?
  actualWeight      Float?
  targetSeconds     Int?
  actualSeconds     Int?
  targetMeters      Float?
  actualMeters      Float?
  rpe               Float?
  targetRpe         Float?
  isWarmup          Boolean         @default(false)
  isAmrap           Boolean         @default(false)
  completed         Boolean         @default(false)
  restTakenSec      Int? // actual rest logged after this set (stopwatch)

  @@index([workoutExerciseId])
}

model PersonalRecord {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId String
  recordType String // 1RM | volume | reps | time | distance
  value      Float
  unit       String?
  achievedOn DateTime @db.Date
  notes      String?
  createdAt  DateTime @default(now())

  @@index([userId, exerciseId])
}

/// Workout planned ahead of time; adherence = done (linked workout) vs missed (past, none).
model WorkoutSchedule {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  date       DateTime  @db.Date
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?
  name       String?
  notes      String?
  workout    Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutId  String?   @unique // the session that fulfilled this plan
  skipped    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, date])
}

model TrainingCycle {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  phase     TrainingPhase
  startDate DateTime      @db.Date
  endDate   DateTime?     @db.Date
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, startDate])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  date       DateTime @db.Date
  weightKg   Float?
  bodyFatPct Float?
  chestCm    Float?
  waistCm    Float?
  neckCm     Float?
  hipCm      Float?
  armLCm     Float?
  armRCm     Float?
  legLCm     Float?
  legRCm     Float?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, date])
}

// ============================================================
// Financial
// ============================================================

enum FinAccountKind {
  CHECKING
  SAVINGS
  MONEY_MARKET
  CD // certificate of deposit
  BROKERAGE
  LOAN // legacy — hidden in UI
  OTHER
}

enum CardType {
  CREDIT
  DEBIT
  CHARGE
  PREPAID
  OTHER
}

/// Financial institution — managed like a phone contact: labeled phones/emails,
/// notes, and persons of contact. Accounts/cards reference it via dropdown.
model Institution {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  website   String?
  logoKey   String? // uploaded logo (S3); falls back to favicon-by-website
  notes     String?
  phones    InstitutionPhone[]
  emails    InstitutionEmail[]
  people    InstitutionContact[]
  accounts  FinAccount[]
  cards     CreditCard[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, name])
}

model InstitutionPhone {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  label         String // custom: "Fraud dept", "Local branch", ...
  phone         String

  @@index([institutionId])
}

model InstitutionEmail {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  label         String
  email         String

  @@index([institutionId])
}

model InstitutionContact {
  id            String      @id @default(cuid())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  institutionId String
  name          String
  role          String? // "Local branch rep", "Corporate", ...
  phone         String?
  email         String?
  notes         String?

  @@index([institutionId])
}

enum TransactionSource {
  MANUAL
  PLAID
  CSV
  STATEMENT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum SubscriptionCadence {
  MONTHLY
  YEARLY
  WEEKLY
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
}

model FinAccount {
  id                String           @id @default(cuid())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  kind              FinAccountKind   @default(CHECKING)
  institution       String? // legacy free-text
  institutionRef    Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionId     String?
  nickname          String?
  branchLocation    String?
  openedAt          DateTime?        @db.Date
  closedAt          DateTime?        @db.Date
  owners            SocialContact[]  @relation("FinAccountOwners")
  last4             String?
  currency          String           @default("USD")
  currentBalance    Decimal          @default(0) @db.Decimal(14, 2)
  lastBalanceAt     DateTime?
  includeInNetWorth Boolean          @default(true)
  isAsset           Boolean          @default(true)
  notes             String?
  archived          Boolean          @default(false)
  // account replacement chain (re-issued/renumbered accounts are "the same account")
  replacedBy        FinAccount?      @relation("AccountReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedById      String?
  replaces          FinAccount[]     @relation("AccountReplacement")
  // brokerage (kind == BROKERAGE): holdings + optional Alpaca link for live values
  holdings          Holding[]
  alpacaLinked      Boolean          @default(false) // mirror live Alpaca equity into this account's value
  transactions      FinTransaction[]
  statements        FinStatement[]
  incomeStreams     IncomeStream[]
  openedFromPlans   FinancialPlan[]  @relation("PlanOpenedAccount")
  plaidAccount      PlaidAccount?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, archived])
}

model CreditCard {
  id                   String           @id @default(cuid())
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  issuer               String? // legacy free-text
  institutionRef       Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionId        String?
  nickname             String?
  cardType             CardType         @default(CREDIT)
  expMonth             Int?
  expYear              Int?
  branchLocation       String?
  openedAt             DateTime?        @db.Date
  closedAt             DateTime?        @db.Date
  owners               SocialContact[]  @relation("CreditCardOwners")
  productName          String?
  last4                String?
  apr                  Decimal?         @db.Decimal(6, 3)
  creditLimit          Decimal?         @db.Decimal(12, 2)
  currentBalance       Decimal          @default(0) @db.Decimal(12, 2)
  cardStyle            String?
  cardImageKey         String?
  ///
  /// From Plaid Liabilities — minimum payment due this cycle.
  ///
  minimumPayment       Decimal?         @db.Decimal(12, 2)
  paymentDueAt         DateTime?        @db.Date
  lastPaymentAmount    Decimal?         @db.Decimal(12, 2)
  paymentOverdue       Boolean          @default(false)
  lastStatementBalance Decimal?         @db.Decimal(12, 2)
  rewardsNotes         String?
  notes                String?
  archived             Boolean          @default(false)
  replacedBy           CreditCard?      @relation("CardReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedById         String?
  replaces             CreditCard[]     @relation("CardReplacement")
  cardNumbers          CardNumber[]
  rewards              CardReward[]
  perks                CardPerk[]
  openedFromPlans      FinancialPlan[]  @relation("PlanOpenedCard")
  transactions         FinTransaction[]
  statements           FinStatement[]
  plaidAccount         PlaidAccount?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId, archived])
}

enum FinancialPlanKind {
  ACCOUNT
  CARD
  BROKERAGE
  OTHER
}

enum FinancialPlanStatus {
  PLANNED
  OPENED
  DISMISSED
}

/// A planned/future financial product to open (a card or account) scheduled for later.
model FinancialPlan {
  id                String              @id @default(cuid())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  kind              FinancialPlanKind   @default(CARD)
  name              String // e.g. "Amex Platinum", "Ally HYSA"
  institutionName   String?
  accountKind       FinAccountKind? // when kind == ACCOUNT/BROKERAGE
  cardType          CardType? // when kind == CARD
  targetDate        DateTime?           @db.Date // when you plan to open it
  reason            String? // why (sign-up bonus, rewards, emergency fund...)
  expectedAnnualFee Decimal?            @db.Decimal(12, 2)
  expectedBonus     String? // free text: "75k points after $4k spend"
  notes             String?
  status            FinancialPlanStatus @default(PLANNED)
  // once opened, link to the real product it became
  finAccount        FinAccount?         @relation("PlanOpenedAccount", fields: [finAccountId], references: [id], onDelete: SetNull)
  finAccountId      String?
  creditCard        CreditCard?         @relation("PlanOpenedCard", fields: [creditCardId], references: [id], onDelete: SetNull)
  creditCardId      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, status, targetDate])
}

enum CardRewardType {
  PERCENT // % back (e.g. 3% on dining)
  POINTS // points/x multiplier (e.g. 4x on groceries)
  MILES // airline miles
  CASHBACK // flat cash back
}

/// A reward a card earns in a category (e.g. "3% on dining", "4x points on groceries").
model CardReward {
  id           String         @id @default(cuid())
  creditCard   CreditCard     @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  creditCardId String
  category     String // "Dining", "Groceries", "Travel", "Everything else", ...
  type         CardRewardType @default(PERCENT)
  rate         Float // 3 (=> 3% / 3x), 1.5, etc.
  cap          String? // optional spend cap / condition, free text
  notes        String?
  order        Int            @default(0)

  @@index([creditCardId])
}

/// A general (non-category) card perk (lounge access, credits, insurance, etc.).
model CardPerk {
  id           String     @id @default(cuid())
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  creditCardId String
  title        String // "Amex Gold $120 dining credit", "Priority Pass lounge access"
  description  String?
  order        Int        @default(0)

  @@index([creditCardId])
}

model CardNumber {
  id           String     @id @default(cuid())
  creditCard   CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  creditCardId String
  last4        String
  validFrom    DateTime?
  validTo      DateTime?
  isCurrent    Boolean    @default(true)
  notes        String?

  @@index([creditCardId])
}

model BrokerageAccount {
  id           String         @id @default(cuid())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  brokerage    String?
  accountName  String?
  accountType  String?
  currentValue Decimal        @default(0) @db.Decimal(14, 2)
  notes        String?
  archived     Boolean        @default(false)
  holdings     Holding[]
  statements   FinStatement[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId, archived])
}

model Holding {
  id                 String            @id @default(cuid())
  // holdings now attach to a FinAccount of kind BROKERAGE (legacy brokerageAccount kept nullable)
  finAccount         FinAccount?       @relation(fields: [finAccountId], references: [id], onDelete: Cascade)
  finAccountId       String?
  brokerageAccount   BrokerageAccount? @relation(fields: [brokerageAccountId], references: [id], onDelete: Cascade)
  brokerageAccountId String?
  symbol             String
  shares             Decimal           @db.Decimal(14, 6)
  costBasisPerShare  Decimal?          @db.Decimal(12, 4)
  currentPrice       Decimal?          @db.Decimal(12, 4)
  asOf               DateTime?

  @@index([finAccountId])
  @@index([brokerageAccountId])
}

model FinStatement {
  id                        String            @id @default(cuid())
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String
  finAccount                FinAccount?       @relation(fields: [finAccountId], references: [id], onDelete: Cascade)
  finAccountId              String?
  creditCard                CreditCard?       @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  creditCardId              String?
  brokerageAccount          BrokerageAccount? @relation(fields: [brokerageAccountId], references: [id], onDelete: Cascade)
  brokerageAccountId        String?
  fileKey                   String
  fileName                  String
  fileSha256                String?
  mimeType                  String?
  fileSize                  Int?
  periodStart               DateTime?
  periodEnd                 DateTime?
  endingBalance             Decimal?          @db.Decimal(14, 2)
  extractedTransactionCount Int?
  processingStatus          ProcessingStatus  @default(PENDING)
  processedAt               DateTime?
  aiExtractedAt             DateTime? // last time AI extraction ran on this statement
  processingError           String?
  rawExtraction             Json?
  transactions              FinTransaction[]
  createdAt                 DateTime          @default(now())

  @@index([userId])
  @@index([userId, fileSha256])
}

model FinTransaction {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  finAccount         FinAccount?        @relation(fields: [finAccountId], references: [id], onDelete: Cascade)
  finAccountId       String?
  creditCard         CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  creditCardId       String?
  statement          FinStatement?      @relation(fields: [statementId], references: [id], onDelete: SetNull)
  statementId        String?
  date               DateTime           @db.Date
  amount             Decimal            @db.Decimal(14, 2) // negative = outflow
  currency           String             @default("USD")
  merchant           String?
  rawDescription     String?
  category           BudgetCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId         String?
  pending            Boolean            @default(false)
  source             TransactionSource  @default(MANUAL)
  dedupHash          String?
  plaidTransactionId String?            @unique
  ///
  /// Plaid personal_finance_category.primary or legacy category tag.
  ///
  plaidCategory      String?
  notes              String?
  receiptKey         String? // S3 object key of an attached receipt image
  receiptFileName    String?
  receiptMimeType    String?
  splits             TransactionSplit[]
  subscription       FinSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, date])
  @@index([finAccountId])
  @@index([creditCardId])
}

/// One slice of a split transaction, allocating part of the amount to a category.
/// The split amounts use the same sign convention as the parent transaction.
model TransactionSplit {
  id            String          @id @default(cuid())
  transaction   FinTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  category      BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId    String?
  amount        Decimal         @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime        @default(now())

  @@index([transactionId])
  @@index([categoryId])
}

/// Global FX rates to USD, refreshed from a public source. `rateToUsd` = USD per 1 unit.
model ExchangeRate {
  code      String   @id // ISO 4217 currency code, e.g. "EUR"
  rateToUsd Decimal  @db.Decimal(18, 8)
  asOf      DateTime
}

model BudgetCategory {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  color         String? // utility color family name, shared by budget + transaction tags
  parent        BudgetCategory?    @relation("BudgetHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  parentId      String?
  children      BudgetCategory[]   @relation("BudgetHierarchy")
  monthlyBudget Decimal?           @db.Decimal(12, 2)
  transactions  FinTransaction[]
  splits        TransactionSplit[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([userId, name])
}

model FinSubscription {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String?
  merchant     String
  cadence      SubscriptionCadence @default(MONTHLY)
  amount       Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("USD")
  status       SubscriptionStatus  @default(ACTIVE)
  startedOn    DateTime?
  cancelledOn  DateTime?
  nextChargeOn DateTime?
  notes        String?
  transactions FinTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, status])
}

model IncomeStream {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  kind         String?
  finAccount   FinAccount?   @relation(fields: [finAccountId], references: [id], onDelete: SetNull)
  finAccountId String?
  notes        String?
  archived     Boolean       @default(false)
  entries      IncomeEntry[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
}

model IncomeEntry {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  stream     IncomeStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId   String
  amount     Decimal      @db.Decimal(14, 2)
  currency   String       @default("USD")
  receivedAt DateTime
  source     String       @default("MANUAL")
  notes      String?
  createdAt  DateTime     @default(now())

  @@index([streamId])
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  asOf        DateTime
  assets      Decimal  @db.Decimal(16, 2)
  liabilities Decimal  @db.Decimal(16, 2)
  netWorth    Decimal  @db.Decimal(16, 2)
  breakdown   Json?
  createdAt   DateTime @default(now())

  @@index([userId, asOf])
}

model TaxDocument {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  taxYear     Int
  kind        String?
  description String?
  fileKey     String?
  fileName    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, taxYear])
}

model Debt {
  id                 String    @id @default(cuid())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  name               String
  kind               String?
  principalOriginal  Decimal?  @db.Decimal(14, 2)
  principalRemaining Decimal?  @db.Decimal(14, 2)
  apr                Decimal?  @db.Decimal(6, 3)
  minimumPayment     Decimal?  @db.Decimal(12, 2)
  payoffGoalDate     DateTime?
  strategy           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

enum CreditBureau {
  EQUIFAX
  EXPERIAN
  TRANSUNION
}

model CreditScoreEntry {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  bureau    CreditBureau?
  score     Int
  scoreDate DateTime      @db.Date
  notes     String?
  createdAt DateTime      @default(now())

  @@index([userId, scoreDate])
}

model FinancialGoal {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  title         String
  targetAmount  Decimal?  @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

// ============================================================
// Social
// ============================================================

model SocialContact {
  id                     String    @id @default(cuid())
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  displayName            String
  firstName              String?
  lastName               String?
  nickname               String?
  avatarKey              String?
  relationshipType       String?
  howWeMet               String?
  birthday               DateTime?
  occupation             String?
  companyOrSchool        String?
  hometown               String?
  timezone               String?
  pronouns               String?
  status                 String?
  interests              String?
  notes                  String?
  closenessScore         Int?
  trustScore             Int?
  communicationFrequency String?
  energyTags             String[]  @default([])
  innerCircle            Boolean   @default(false)
  stayInTouch            Boolean   @default(false)
  stayInTouchDays        Int?
  preferredContactMethod String?
  lastContactAt          DateTime?
  active                 Boolean   @default(true)

  emails             ContactEmail[]
  phones             ContactPhone[]
  handles            ContactHandle[]
  addresses          ContactAddress[]
  dates              ContactDate[]
  contactNotes       ContactNote[]
  reminders          ContactReminder[]
  interactions       SocialInteraction[]
  communications     CommunicationLog[]
  memories           SocialMemory[]
  gifts              SocialGift[]
  conflicts          SocialConflict[]
  tags               SocialTag[]         @relation("ContactTags")
  connectionsA       SocialConnection[]  @relation("ConnectionContact1")
  connectionsB       SocialConnection[]  @relation("ConnectionContact2")
  eventAttendees     EventAttendee[]
  outreachDrafts     OutreachDraft[]
  recurringReminders RecurringReminder[]
  ownedAccounts      FinAccount[]        @relation("FinAccountOwners")
  ownedCards         CreditCard[]        @relation("CreditCardOwners")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, displayName])
}

model ContactEmail {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  email     String
  label     String        @default("Other")
  isPrimary Boolean       @default(false)

  @@index([contactId])
}

model ContactPhone {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  phone     String
  label     String        @default("Mobile")
  isPrimary Boolean       @default(false)

  @@index([contactId])
}

model ContactHandle {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  platform  String
  handle    String

  @@index([contactId])
}

model ContactAddress {
  id           String        @id @default(cuid())
  contact      SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String
  addressType  String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  @@index([contactId])
}

model ContactDate {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  dateType  String
  dateValue DateTime      @db.Date

  @@index([contactId])
}

model ContactNote {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  noteType  String?
  noteText  String
  createdAt DateTime      @default(now())

  @@index([contactId])
}

model ContactReminder {
  id           String        @id @default(cuid())
  contact      SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId    String
  reminderType String?
  scheduledFor DateTime
  completed    Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([contactId])
}

model SocialInteraction {
  id              String        @id @default(cuid())
  contact         SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  interactionType String?
  date            DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([contactId, date])
}

model CommunicationLog {
  id        String        @id @default(cuid())
  contact   SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  channel   String?
  date      DateTime      @default(now())
  notes     String?
  sentiment String?
  createdAt DateTime      @default(now())

  @@index([contactId, date])
}

model SocialEvent {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  name          String
  eventDate     DateTime?
  location      String?
  attendees     Json?
  notes         String?
  coverImageKey String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model SocialMemory {
  id          String              @id @default(cuid())
  contact     SocialContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String
  title       String?
  description String
  memoryDate  DateTime?
  location    String?
  mediaKeys   String[]            @default([]) // legacy
  media       SocialMemoryMedia[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([contactId])
}

/// Photo/video (any type) attached to a memory — preview/download/edit/remove.
model SocialMemoryMedia {
  id        String       @id @default(cuid())
  memory    SocialMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  memoryId  String
  key       String // S3 object key
  fileName  String
  mimeType  String
  sizeBytes Int?
  createdAt DateTime     @default(now())

  @@index([memoryId])
}

model SocialGift {
  id              String        @id @default(cuid())
  contact         SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId       String
  giftDescription String
  givenDate       DateTime?
  occasion        String?
  direction       String? // given | received
  createdAt       DateTime      @default(now())

  @@index([contactId])
}

model SocialBattery {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime @db.Date
  energyLevel Int
  notes       String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
}

model SocialConflict {
  id          String        @id @default(cuid())
  contact     SocialContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId   String
  date        DateTime?
  description String
  resolution  String?
  createdAt   DateTime      @default(now())

  @@index([contactId])
}

model SocialTag {
  id       String          @id @default(cuid())
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  name     String
  color    String?
  contacts SocialContact[] @relation("ContactTags")

  @@unique([userId, name])
}

/// Drafted outreach message (text/DM/email) with an optional send-by deadline.
model OutreachDraft {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  contact   SocialContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
  channel   String? // text | email | dm | call...
  body      String
  dueAt     DateTime? // send-by deadline (e.g. +1d, +7d, +30d)
  sentAt    DateTime?
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, dueAt])
}

model SocialConnection {
  id               String        @id @default(cuid())
  contact1         SocialContact @relation("ConnectionContact1", fields: [contact1Id], references: [id], onDelete: Cascade)
  contact1Id       String
  contact2         SocialContact @relation("ConnectionContact2", fields: [contact2Id], references: [id], onDelete: Cascade)
  contact2Id       String
  relationshipType String?
  notes            String?
  createdAt        DateTime      @default(now())

  @@index([contact1Id])
  @@index([contact2Id])
}

// ============================================================
// Learning
// ============================================================

model LearningCourse {
  id                   String           @id @default(cuid())
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  title                String
  source               String? // free-text origin label (legacy)
  provider             String? // youtube | udemy | coursera | other
  url                  String?
  thumbnailUrl         String?
  description          String?
  status               String? // planned | in_progress | completed
  totalDurationSeconds Int?
  timeInvestedMinutes  Int              @default(0)
  rating               Int? // 1-5 personal rating after completion
  review               String? // private notes
  certificateKey       String? // S3 object key for an uploaded certificate
  linkedGoal           LearningGoal?    @relation(fields: [linkedGoalId], references: [id], onDelete: SetNull)
  linkedGoalId         String?
  startedOn            DateTime?
  completedOn          DateTime?
  lessons              LearningLesson[]
  quizzes              Quiz[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([linkedGoalId])
}

model LearningLesson {
  id               String         @id @default(cuid())
  course           LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  title            String
  description      String?
  completed        Boolean        @default(false)
  estimatedMinutes Int?
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([courseId])
}

model LearningGoal {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  goalType      String?
  title         String? // short label; description holds detail
  description   String
  color         String?
  targetDate    DateTime?
  completed     Boolean            @default(false)
  streakCount   Int                @default(0)
  lastStudiedOn DateTime?          @db.Date
  freezeTokens  Int                @default(0)
  milestones    GoalMilestone[]
  resources     LearningResource[]
  linkedCourses LearningCourse[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
}

model LearningSkill {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  proficiency Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model LearningResource {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  goal         LearningGoal? @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId       String?
  title        String
  resourceType String? // link | video | book | note
  url          String?
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([goalId])
}

model Flashcard {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  front          String
  back           String
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?
  // SM-2 spaced-repetition scheduling
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, dueDate])
}

model Quiz {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  course      LearningCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId    String?
  title       String
  description String?
  topic       String?
  aiGenerated Boolean         @default(false)
  aiTeach     Boolean         @default(false) // "AI quiz and teach" — AI augments questions + explanations
  links       Json? // refs to linked flashcard/note ids: { flashcardIds: [], noteIds: [] }
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

/// Quiz question with rich markdown content (code blocks, links, quotes, images/diagrams).
model QuizQuestion {
  id          String   @id @default(cuid())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  order       Int      @default(0)
  prompt      String // markdown
  choices     Json // [{ text: string (markdown), correct: boolean }]
  explanation String? // markdown — shown after answering ("teach" mode)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quizId, order])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId    String
  score     Float?
  answers   Json? // per-question selections
  createdAt DateTime @default(now())

  @@index([quizId])
}

model LearningNote {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model LearningSession {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  sessionDate     DateTime @db.Date
  durationMinutes Int?
  notes           String?
  subject         String?
  // Lightweight attribution (nullable scalar refs, no FK cascade needed).
  courseId        String?
  classId         String?
  goalId          String?
  energy          Int? // 1-5 mood/energy rating
  pomodoro        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, sessionDate])
}

model LearningPlanEntry {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  scheduledFor DateTime?
  completed    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model LearningAchievement {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  achievementType String
  title           String?
  earnedOn        DateTime @db.Date
  createdAt       DateTime @default(now())

  @@index([userId])
}

// ── Academic mode ────────────────────────────────────────────

enum GradeLevel {
  HIGH_SCHOOL
  UNDERGRAD
  GRAD
}

enum ClassStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum HomeworkStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum WatchStatus {
  NOT_WATCHED
  WATCHING
  WATCHED
}

/// An academic class with a configurable weighted grade tracker.
model LearningClass {
  id           String            @id @default(cuid())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  name         String
  gradeLevel   GradeLevel        @default(UNDERGRAD)
  creditHours  Float?
  term         String? // e.g. "Fall 2026"
  instructor   String?
  color        String?
  status       ClassStatus       @default(ACTIVE)
  gradeWeights Json? // [{ name: string, weight: number }] — should sum to 100
  absenceLimit Int? // e.g. 3 = dropped after 3 absences
  finalGrade   Float? // locked final percent when completed
  assignments  ClassAssignment[]
  tests        ClassTest[]
  absences     ClassAbsence[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
}

/// Homework / assignment tracked against a class's weighted categories.
model ClassAssignment {
  id             String         @id @default(cuid())
  class          LearningClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId        String
  title          String
  category       String? // matches a gradeWeights[].name bucket
  dueDate        DateTime?
  status         HomeworkStatus @default(NOT_STARTED)
  pointsEarned   Float?
  pointsPossible Float?
  extraCredit    Boolean        @default(false)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([classId])
}

/// Test / quiz log entry with optional curve adjustment.
model ClassTest {
  id              String        @id @default(cuid())
  class           LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId         String
  title           String
  category        String?
  date            DateTime?
  score           Float?
  maxScore        Float?
  curveAdjustment Float?        @default(0) // points added to the raw score
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([classId])
}

/// A single absence entry for a class (attendance log).
model ClassAbsence {
  id        String        @id @default(cuid())
  class     LearningClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  date      DateTime      @db.Date
  reason    String?
  excused   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([classId])
}

// ── Goal-Based mode ──────────────────────────────────────────

/// A milestone breaking a learning goal into trackable steps.
model GoalMilestone {
  id        String          @id @default(cuid())
  goal      LearningGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId    String
  title     String
  dueDate   DateTime?
  status    MilestoneStatus @default(NOT_STARTED)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([goalId])
}

// ── YouTube Video Archive ────────────────────────────────────

/// An AI-generated thematic group of archived videos with a collage cover.
model VideoGroup {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  themeColor String?
  coverKey   String? // S3 object key for the 2x2 collage cover
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  videos     ArchiveVideo[]

  @@index([userId])
}

/// A single archived YouTube video.
model ArchiveVideo {
  id              String      @id @default(cuid())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  group           VideoGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId         String?
  youtubeId       String
  url             String
  title           String
  channel         String?
  thumbnailUrl    String?
  durationSeconds Int? // manual (oEmbed does not expose duration)
  watchStatus     WatchStatus @default(NOT_WATCHED)
  watchProgress   Int         @default(0) // 0-100
  notes           String?
  addedAt         DateTime    @default(now())
  createdAt       DateTime    @default(now())

  @@unique([userId, youtubeId])
  @@index([userId])
  @@index([groupId])
}

/// A public, view-only share link for a note or the user's flashcard deck.
model LearningShare {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  kind      String // "note" | "deck"
  noteId    String? // set when kind = "note"
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// Focus & life engine
// ============================================================

model FocusSprint {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  title           String
  durationMinutes Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model WeeklyPriority {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  weekOf       DateTime @db.Date
  priorityText String
  order        Int      @default(0)
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, weekOf])
}

model RewardGoal {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  description String
  points      Int      @default(0)
  earned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model GoalPeriod {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  periodName String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
