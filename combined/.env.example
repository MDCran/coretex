# Generate unique values, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Keep this key stable. It encrypts OAuth tokens and brokerage credentials at rest.
DATA_ENCRYPTION_KEY=

# Local infrastructure defaults used by combined/docker-compose.yml.
DATABASE_URL=postgresql://lifeos:lifeos@localhost:5450/lifeos?schema=public
S3_ENDPOINT=http://localhost:9400
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lifeos
REDIS_URL=redis://localhost:6390
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Optional integrations. Leave unused values empty and never commit a filled .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3200/api/spotify/callback
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
GENIUS_REDIRECT_URI=http://localhost:3200/api/genius/callback
NEXT_PUBLIC_LOGOKIT_TOKEN=
