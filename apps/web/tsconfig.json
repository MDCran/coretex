{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": ["../../shared/src/components/*"],
      "@/hooks/*":      ["../../shared/src/hooks/*"],
      "@/utils/*":      ["../../shared/src/utils/*"],
      "@/lib/*":        ["../../shared/src/lib/*"],
      "@/coretex":      ["../../shared/src/coretex"],
      "@/coretex/*":    ["../../shared/src/coretex/*"],
      "@/*":            ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../shared/src/**/*.ts",
    "../../shared/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
